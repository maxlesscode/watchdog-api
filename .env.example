DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=database_password
DB_NAME=postgres

API_KEY=your_api_key

# Optional — email alerts (all five required if SMTP_HOST is set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=your_smtp_password
ALERT_EMAIL=you@example.com

# Optional — dev mode (stdout logging)
IS_DEV=true
