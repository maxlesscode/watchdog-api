DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=database_password
DB_NAME=postgres
# "disable" for local dev; "require" or "verify-full" in production
DB_SSL_MODE=disable

API_KEY=your_api_key

# Optional — email alerts (all five required if SMTP_HOST is set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=your_smtp_password
ALERT_EMAIL=you@example.com

# Optional — dev mode (stdout logging); set to "true" to enable
IS_DEV=true

# Optional — log file path (default: watchdog.log; use logs/watchdog.log when running via Docker)
LOG_PATH=logs/watchdog.log

# Optional — HTTP listen address (default: :9999)
# SERVER_ADDR=:9999

# Optional — allowed CORS origins, comma-separated. Use "*" for wildcard (dev only).
# Swagger UI default: http://localhost:8081
CORS_ORIGINS=http://localhost:8081

# Optional — Docker: image version tag passed as build arg; port binding override
APP_VERSION=dev
APP_PORT=9999
